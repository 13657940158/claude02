# ============================================================
# 墨舟 BookMate — 环境变量模板（你来填）
# ------------------------------------------------------------
# 用法：
#   1) 本文件就是可用的 .env，已放在 bookmate/.env
#   2) 只需填写标注【必填】的项；其余保持默认即可
#   3) 不要把本文件提交到 Git（已在 .gitignore 中排除）
#   4) 本地不跑任何模型：LLM / Embedding / Rerank 全部走在线 API
#   5) Docker 只用来起 MySQL / Redis / Qdrant 与应用容器，不跑模型
# ============================================================

# ---------------- 1. 应用 ----------------
APP_NAME=BookMate
APP_ENV=dev
# 【必填】JWT 与签名密钥，>=32 字符。生成命令：
#   py -3 -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET_KEY=
APP_BASE_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# ---------------- 2. MySQL（Docker 本地容器） ----------------
# 注意：MYSQL_PASSWORD 必须与下面两条 DATABASE_URL 中的密码一致
MYSQL_ROOT_PASSWORD=<your-password>
MYSQL_DATABASE=bookmate
MYSQL_USER=bookmate
MYSQL_PASSWORD=<your-password>
DATABASE_URL=mysql+aiomysql://bookmate:bookmate_dev_2026@127.0.0.1:3306/bookmate?charset=utf8mb4
DATABASE_SYNC_URL=mysql+pymysql://bookmate:bookmate_dev_2026@127.0.0.1:3306/bookmate?charset=utf8mb4

# ---------------- 3. Redis / Qdrant（Docker 本地容器） ----------------
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
# 本地开发留空；生产填 Qdrant API Key
QDRANT_API_KEY=
COLLECTION_NAME=book_chunks

# ---------------- 4. LLM（在线 API，必填） ----------------
# 默认 SiliconFlow（OpenAI 兼容）。也可换阿里百炼 / DeepSeek / 自建网关，
# 只改 BASE_URL 与 MODEL 即可。
LLM_MODE=real
LLM_BASE_URL=https://api.siliconflow.cn/v1
# 【必填】在线大模型 Key（不要复用编辑器配置里的令牌）
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# 评测 judge / 调优归因使用的模型，建议与主模型同档
LLM_JUDGE_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=4

# ---------------- 5. Embedding（在线 API，必填） ----------------
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 【必填】可填与 LLM_API_KEY 相同的 Key（同一个 SiliconFlow 账号即可）
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ---------------- 6. Rerank（在线 API，必填） ----------------
RERANK_ENABLED=true
RERANK_BASE_URL=https://api.siliconflow.cn/v1
# 【必填】同样可复用上面的 SiliconFlow Key
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=15
RERANK_TOP_N=8

# ---------------- 7. 四域业务接口（可后补；默认 mock） ----------------
# mock：使用内置假数据，完整流程可跑通
# real：填写下面四个 BASE_URL 与鉴权后切换
DOMAIN_MODE=mock
AUDIO_DATA_BASE_URL=
EDU_DATA_BASE_URL=
TRAVEL_DATA_BASE_URL=
FINANCE_DATA_BASE_URL=
DOMAIN_API_KEY=
DOMAIN_TIMEOUT_SECONDS=3

# ---------------- 8. 账号与安全 ----------------
ADMIN_EMAIL=admin@example.com
# 【必填】首次初始化管理员密码，>=8 位，含字母与数字
ADMIN_PASSWORD=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=60
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
MAX_UPLOAD_MB=20

# ---------------- 9. 语料自举与自动入库 ----------------
# AUTO_BOOTSTRAP=true：首次启动自动 建表 -> 导入内置书目 -> 入库语料 -> 建索引 -> 验证检索
# 已初始化过会自动跳过，不会重复写入
AUTO_BOOTSTRAP=true
AUTO_INGEST=true
CORPUS_DIR=./data/books
# worker 增量巡检间隔（秒）；<=0 只扫一次。开发栈 compose 默认覆盖为 300
CORPUS_WATCH_SECONDS=1800
SEED_BOOK_COUNT=12
TASK_BATCH_SIZE=40
INGEST_MAX_CHARS=5000000

# ---------------- 10. RAG 评测 ----------------
EVAL_MAX_CASES=50
EVAL_CONCURRENCY=3
EVAL_DATASET=eval/datasets/golden_v1.jsonl
EVAL_REPORT_DIR=eval/reports

# ---------------- 11. 部署（项目完成后再填） ----------------
# 仅本地 dev compose 使用；生产标签由 scripts/deploy.sh 自动生成（prod-时间戳）
IMAGE_TAG=dev
# 生产 compose：对外只暴露 Nginx 的 HTTP_PORT；语料目录可在宿主机单独挂载
HTTP_PORT=8080
# 生产语料目录（宿主机绝对路径，如 /opt/bookmate/data/books）；留空用仓库内 data/books
CORPUS_HOST_DIR=
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_DIR=/opt/bookmate
SERVER_PUBLIC_URL=
